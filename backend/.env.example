# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/geypal
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/geypal?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=noreply@geypal.com

# Frontend
FRONTEND_URL=http://localhost:3000

# Webhook
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_from_paystack
